# Copie para ~/.rolox.env e preencha. NUNCA coloque este arquivo preenchido no GitHub.
# Quem tiver o link de um webhook consegue postar no canal.

# Token do bot (Discord Developer Portal > seu app > Bot > Reset Token)
DISCORD_TOKEN=

# Webhook do canal de BANIMENTOS (ban, desban, IP bloqueado/desbloqueado)
ROLOX_WEBHOOK_BANIMENTOS=https://discord.com/api/webhooks/...

# Webhook do canal de PUNIÇÕES (sem chat, chat liberado, aviso)
ROLOX_WEBHOOK_PUNICOES=https://discord.com/api/webhooks/...
